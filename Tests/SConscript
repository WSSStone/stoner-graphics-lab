"""Test executable build script — links against all layer static libraries."""

Import('env', 'platform', 'config')
import os
from GraphicsDependencyDetect import DetectGraphicsDependencies

test_env = env.Clone()
graphics_deps = DetectGraphicsDependencies(platform)

# Include paths for all layers (to validate the full include chain)
# Use '#' prefix to get absolute paths for compiler -I flags
_SOURCE_ROOT = 'Source'
_LAYERS = ['Application', 'Renderer', 'RHI', 'Core']
_BACKEND_LAYERS = [os.path.join('Backend', 'Vulkan')]

include_paths = []
for layer in _LAYERS:
    public_dir = os.path.join(_SOURCE_ROOT, layer, 'Public')
    include_paths.append(Dir('#' + public_dir).abspath)

for backend in _BACKEND_LAYERS:
    public_dir = os.path.join(_SOURCE_ROOT, backend, 'Public')
    include_paths.append(Dir('#' + public_dir).abspath)

test_env.Append(CPPPATH=include_paths)
test_env.Append(CPPPATH=[Dir('#Demo/StonerDemo/Private').abspath])
test_env.Append(CPPPATH=[Dir('#Source/Application/Private').abspath])

# Source files — use relative path to SConscript source dir for variant_dir compat
tests_src_dir = Dir('.').srcnode().abspath
cpp_files = sorted(f for f in os.listdir(tests_src_dir) if f.endswith('.cpp'))
rel_src_dir = os.path.relpath(tests_src_dir, Dir('.').srcnode().abspath)
sources = [os.path.join(rel_src_dir, f) for f in cpp_files]

# Build output base
config_display = 'Debug' if config == 'debug' else 'Release'
build_base = os.path.join('#Build', platform, config_display)

# Library search paths — point to each layer's variant_dir output
_LIB_LAYERS = ['Core', 'RHI', 'Renderer', 'Application']
_BACKEND_LIB_LAYERS = [os.path.join('Backend', 'Vulkan')]
lib_paths = [Dir(os.path.join(build_base, layer)).abspath for layer in _LIB_LAYERS]
lib_paths += [Dir(os.path.join(build_base, backend)).abspath for backend in _BACKEND_LIB_LAYERS]
lib_paths.append(Dir(os.path.join(build_base, 'Demo', 'StonerDemo')).abspath)
test_env.Append(LIBPATH=lib_paths)

# Libraries to link (order matters for static linking: dependents first)
test_env.Append(LIBS=['StonerDemoRuntime', 'Application', 'Renderer', 'RHI', 'Core', 'VulkanRHI'])
if platform == 'Linux':
    test_env.Append(LIBS=['dl'])
if platform == 'Win64':
    test_env.Append(LIBS=['Psapi'])
    if graphics_deps['glfw_available']:
        test_env.Append(LIBS=['User32', 'Gdi32', 'Shell32'])
if graphics_deps['vulkan_library']:
    if platform == 'Linux':
        # Keep Vulkan after the static engine libraries for GNU ld --as-needed.
        test_env.Append(LIBS=['vulkan'])
    else:
        test_env.Append(LINKFLAGS=[graphics_deps['vulkan_library']])
    if platform == 'Mac':
        test_env.Append(LINKFLAGS=['-Wl,-rpath,' + os.path.dirname(graphics_deps['vulkan_library'])])
if graphics_deps['glfw_library']:
    test_env.Append(LINKFLAGS=[graphics_deps['glfw_library']])
    if platform in ('Mac', 'Linux'):
        test_env.Append(LINKFLAGS=['-Wl,-rpath,' + os.path.dirname(graphics_deps['glfw_library'])])
if platform == 'Mac' and graphics_deps['glfw_available']:
    test_env.Append(FRAMEWORKS=['Cocoa', 'IOKit', 'CoreFoundation'])

program = test_env.Program('StonerTest', sources)
Return('program')
