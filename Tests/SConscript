"""Test executable build script — links against all layer static libraries."""

Import('env', 'platform', 'config')
import os
import subprocess
import sys
from SCons.Script import Action, ARGUMENTS
from GraphicsDependencyDetect import DetectGraphicsDependencies

test_env = env.Clone()
graphics_deps = DetectGraphicsDependencies(platform)

# Include paths for all layers (to validate the full include chain)
# Use '#' prefix to get absolute paths for compiler -I flags
_SOURCE_ROOT = 'Source'
_LAYERS = ['Application', 'Renderer', 'RHI', 'Asset', 'Core']
_BACKEND_LAYERS = [
    os.path.join('Backend', 'Vulkan'),
    os.path.join('Backend', 'Metal'),
]

include_paths = []
for layer in _LAYERS:
    public_dir = os.path.join(_SOURCE_ROOT, layer, 'Public')
    include_paths.append(Dir('#' + public_dir).abspath)

for backend in _BACKEND_LAYERS:
    public_dir = os.path.join(_SOURCE_ROOT, backend, 'Public')
    include_paths.append(Dir('#' + public_dir).abspath)

include_paths.extend([
    Dir('#Tools/AssetCooker/Public').abspath,
    Dir('#Tools/AssetCooker/Private').abspath,
    Dir('#ThirdParty/flip').abspath,
])

test_env.Append(CPPPATH=include_paths)
test_env.Append(CPPDEFINES=[
    ('STONER_GLFW_AVAILABLE', int(graphics_deps['glfw_available'])),
    ('STONER_TEST_VULKAN_RUNTIME_AVAILABLE',
        int(graphics_deps['vulkan_available'])),
])
if graphics_deps['glfw_include_dir']:
    test_env.Append(CPPPATH=[graphics_deps['glfw_include_dir']])
if graphics_deps['vulkan_include_dir']:
    test_env.Append(CPPPATH=[graphics_deps['vulkan_include_dir']])

if platform == 'Mac':
    test_env.Append(CCFLAGS=['-Werror=unguarded-availability-new'])

# Source files — use relative path to SConscript source dir for variant_dir compat
tests_src_dir = Dir('.').srcnode().abspath
cpp_files = sorted(
    f for f in os.listdir(tests_src_dir)
    if f.endswith('.cpp') and f != 'AssetRegistryBenchmark.cpp'
)
rel_src_dir = os.path.relpath(tests_src_dir, Dir('.').srcnode().abspath)

private_include_paths_by_source = {
    'ApplicationWindowInputTests.cpp': [
        Dir('#Source/Application/Private').abspath,
    ],
    'CorePlatformTests.cpp': [
        Dir('#Source/Core/Private').abspath,
    ],
    'AssetImageTextureTests.cpp': [
        Dir('#Source/Asset/Private').abspath,
    ],
    'AssetGLTFContainerTests.cpp': [
        Dir('#Source/Asset/Private').abspath,
    ],
    'AssetGLTFPolicyTests.cpp': [
        Dir('#Source/Asset/Private').abspath,
        Dir('#ThirdParty').abspath,
    ],
    'AssetKTX2Tests.cpp': [
        Dir('#Source/Asset/Private').abspath,
        Dir('#ThirdParty/ktx/include').abspath,
    ],
    'AssetMaterialShaderTests.cpp': [
        Dir('#Source/Asset/Private').abspath,
    ],
    'AssetCookerProfileTests.cpp': [
        Dir('#Source/Asset/Private').abspath,
    ],
    'AssetCookerDerivedKeyTests.cpp': [
        Dir('#Source/Asset/Private').abspath,
    ],
    'AssetCookerEquivalenceTests.cpp': [
        Dir('#Source/Asset/Private').abspath,
    ],
    'AssetCookerBenchmark.cpp': [
        Dir('#ThirdParty').abspath,
    ],
    'MetalShaderDerivationTests.cpp': [
        Dir('#ThirdParty/spirv-cross').abspath,
    ],
    'MetalDeviceTests.cpp': [
        Dir('#Source/Backend/Metal/Private').abspath,
    ],
    'MetalDiagnosticsTests.cpp': [
        Dir('#Source/Backend/Metal/Private').abspath,
    ],
    'MetalFailureInjectionTests.cpp': [
        Dir('#Source/Backend/Metal/Private').abspath,
    ],
    'MetalLifecycleStressTests.cpp': [
        Dir('#Source/Backend/Metal/Private').abspath,
    ],
    'MetalCommandTests.cpp': [
        Dir('#Source/Backend/Metal/Private').abspath,
    ],
    'MetalPipelineTests.cpp': [
        Dir('#Source/Backend/Metal/Private').abspath,
    ],
    'VulkanBackendTests.cpp': [
        Dir('#Source/Backend/Vulkan/Private').abspath,
    ],
    'MetalPresentationTests.cpp': [
        Dir('#Source/Backend/Metal/Private').abspath,
    ],
    'TriangleDemoIntegrationTests.cpp': [
        Dir('#Demo/StonerDemo/Private').abspath,
    ],
    'ProductionContentDemoTests.cpp': [
        Dir('#Demo/StonerDemo/Private').abspath,
    ],
    'ProductionCameraPreviewTests.cpp': [
        Dir('#Demo/StonerDemo/Private').abspath,
    ],
    'ProductionContentStrictRuntimeTests.cpp': [
        Dir('#Demo/StonerDemo/Private').abspath,
    ],
    'VulkanProductionContentIntegrationTests.cpp': [
        Dir('#Demo/StonerDemo/Private').abspath,
    ],
    'MetalProductionContentIntegrationTests.cpp': [
        Dir('#Demo/StonerDemo/Private').abspath,
    ],
    'ProductionNativeImageAcceptance.cpp': [
        Dir('#Demo/StonerDemo/Private').abspath,
    ],
    'ProductionImageReference.cpp': [
        Dir('#Source/Asset/Private').abspath,
    ],
    'ProductionImageAcceptance.cpp': [
        Dir('#ThirdParty/flip').abspath,
    ],
    'ProductionImageAcceptanceTests.cpp': [
        Dir('#Demo/StonerDemo/Private').abspath,
    ],
}

private_defines_by_source = {
    'AssetKTX2Tests.cpp': ['KHRONOS_STATIC'],
}

# Runtime Asset Manager tests exercise private scheduling kernels without
# exposing those implementation details through the public Asset API.
for cpp_file in cpp_files:
    if cpp_file.startswith('AssetManager'):
        private_include_paths_by_source.setdefault(cpp_file, []).append(
            Dir('#Source/Asset/Private').abspath)

objects = []
for cpp_file in cpp_files:
    source = os.path.join(rel_src_dir, cpp_file)
    extra_private_paths = private_include_paths_by_source.get(cpp_file)
    extra_private_defines = private_defines_by_source.get(cpp_file)
    if extra_private_paths or extra_private_defines:
        source_env = test_env.Clone()
        source_env.Append(CPPPATH=extra_private_paths or [])
        source_env.Append(CPPDEFINES=extra_private_defines or [])
    else:
        source_env = test_env
    if cpp_file == 'ProductionImageAcceptance.cpp' and platform in ('Mac', 'Linux'):
        source_env = source_env.Clone()
        source_env.Append(CCFLAGS=[
            '-Wno-deprecated-copy-with-user-provided-copy',
            '-Wno-unused-parameter',
        ])
    objects.extend(source_env.Object(source))

for tool_source in (
    'FAssetCookGraph.cpp',
    'FAssetCookCli.cpp',
    'FAssetCookScheduler.cpp',
    'FCookInputSnapshot.cpp',
    'FAssetCookRequest.cpp',
    'FAssetCookReport.cpp',
    'FAssetCookReportCodec.cpp',
    'FAssetCookRunner.cpp',
    'FAssetCookerSelection.cpp',
    'FCookedGenerationPublisher.cpp',
    'FDerivedDataStore.cpp',
    'FAssetSourceCatalog.cpp',
    'FMetalBindingMap.cpp',
    'FMetalLibraryCompiler.cpp',
    'FMetalShaderCooker.cpp',
    'FMetalShaderEvidenceCodec.cpp',
    'FSpirvCrossMslDeriver.cpp',
):
    tool_source_env = test_env.Clone()
    if tool_source == 'FSpirvCrossMslDeriver.cpp':
        tool_source_env.Append(
            CPPPATH=[Dir('#ThirdParty/spirv-cross').abspath],
        )
    objects.extend(tool_source_env.Object(
        os.path.join('AssetCookerTool', tool_source[:-4]),
        File('#Tools/AssetCooker/Private/' + tool_source),
    ))

controlled_loader_source = '#Tests/Helpers/AssetManagerControlledLoader.cpp'
if os.path.isfile(File(controlled_loader_source).srcnode().abspath):
    objects.extend(test_env.Object(File(controlled_loader_source)))

# Build output base
config_display = 'Debug' if config == 'debug' else 'Release'
build_base = os.path.join('#Build', platform, config_display)

# Library search paths — point to each layer's variant_dir output
_LIB_LAYERS = ['Core', 'Asset', 'RHI', 'Renderer', 'Application']
_BACKEND_LIB_LAYERS = [
    os.path.join('Backend', 'Vulkan'),
    os.path.join('Backend', 'Metal'),
]
lib_paths = [Dir(os.path.join(build_base, layer)).abspath for layer in _LIB_LAYERS]
lib_paths += [Dir(os.path.join(build_base, backend)).abspath for backend in _BACKEND_LIB_LAYERS]
lib_paths.append(Dir(os.path.join(build_base, 'Demo', 'StonerDemo')).abspath)
test_env.Append(LIBPATH=lib_paths)

# Libraries to link (order matters for static linking: dependents first)
engine_libs = [
    'StonerDemoRuntime', 'Application', 'Renderer', 'VulkanRHI', 'MetalRHI',
]
engine_libs.extend(['RHI', 'Asset', 'Core'])
test_env.Append(LIBS=engine_libs)
if platform == 'Mac':
    test_env.Append(FRAMEWORKS=['Metal', 'QuartzCore', 'Cocoa', 'Foundation'])
test_env.Append(LIBS=env.get('STONER_ASSET_THIRD_PARTY_LIBS', []))
test_env.Append(LIBS=env.get('STONER_ASSET_COOKER_THIRD_PARTY_LIBS', []))
if platform == 'Linux':
    test_env.Append(LIBS=['dl'])
if platform == 'Win64':
    test_env.Append(LIBS=['Psapi'])
    if graphics_deps['glfw_available']:
        test_env.Append(LIBS=['User32', 'Gdi32', 'Shell32'])
if graphics_deps['vulkan_library']:
    if platform == 'Linux':
        # Keep Vulkan after the static engine libraries for GNU ld --as-needed.
        test_env.Append(LIBS=['vulkan'])
    else:
        test_env.Append(LINKFLAGS=[graphics_deps['vulkan_library']])
    if platform == 'Mac':
        test_env.Append(LINKFLAGS=['-Wl,-rpath,' + os.path.dirname(graphics_deps['vulkan_library'])])
if graphics_deps['glfw_library']:
    test_env.Append(LINKFLAGS=[graphics_deps['glfw_library']])
    if platform in ('Mac', 'Linux'):
        test_env.Append(LINKFLAGS=['-Wl,-rpath,' + os.path.dirname(graphics_deps['glfw_library'])])
if platform == 'Mac' and graphics_deps['glfw_available']:
    test_env.Append(FRAMEWORKS=['Cocoa', 'IOKit', 'CoreFoundation'])

program = test_env.Program('StonerTest', objects)
test_env.Depends(program, env['STONER_ASSET_COOKER_PROGRAM'])
test_env.Alias('asset-cooker-benchmark', program)

if platform == 'Mac':
    presentation_probe_env = test_env.Clone()
    presentation_probe_env.Append(CCFLAGS=['-fobjc-arc'])
    presentation_probe = presentation_probe_env.Program(
        'MetalPresentationProbe',
        [File('#Tests/Helpers/MetalPresentationProbe.mm')],
    )
    test_env.Depends(program, presentation_probe)

lease_probe = test_env.Program(
    'PlatformFileLeaseProbe',
    [File('#Tests/Helpers/PlatformFileLeaseProbe.cpp')],
)
test_env.Depends(program, lease_probe)

process_probe = test_env.Program(
    'PlatformProcessProbe',
    [File('#Tests/Helpers/PlatformProcessProbe.cpp')],
)
test_env.Depends(program, process_probe)

publication_probe = test_env.Program(
    'AssetCookerPublicationProbe',
    [
        File('#Tests/Helpers/AssetCookerPublicationProbe.cpp'),
        test_env.Object(
            'AssetCookerPublicationProbePublisher',
            File('#Tools/AssetCooker/Private/FCookedGenerationPublisher.cpp')),
    ],
)
test_env.Depends(program, publication_probe)

# Feature 026 process helpers are introduced test-first. Build the probe as soon
# as its source enters the fixture tree.
generation_lease_probe = None
generation_lease_probe_source = '#Tests/Helpers/GenerationReaderLeaseProbe.cpp'
if os.path.isfile(File(generation_lease_probe_source).srcnode().abspath):
    generation_lease_probe = test_env.Program(
        'GenerationReaderLeaseProbe',
        [File(generation_lease_probe_source)],
    )
    test_env.Depends(program, generation_lease_probe)

asset_benchmark = None
if ARGUMENTS.get('asset_benchmark', '0').lower() in ('1', 'true', 'yes', 'on'):
    benchmark_object = test_env.Object('AssetRegistryBenchmark.cpp')
    asset_benchmark = test_env.Program('StonerAssetBenchmark', [benchmark_object])

platform_matrix_script = File('#Tests/verify_platform_identity.py')
platform_header = File('#Source/Core/Public/Core/SGPlatform.h')
platform_matrix_stamp = File('PlatformIdentityMatrix.stamp')

def _verify_platform_identity(target, source, env):
    command = [
        sys.executable,
        source[0].srcnode().abspath,
        '--compiler',
        env.subst('$CXX'),
        '--style',
        'msvc' if platform == 'Win64' else 'posix',
        '--include',
        Dir('#Source/Core/Public').abspath,
        '--stamp',
        target[0].abspath,
    ]
    process_environment = os.environ.copy()
    process_environment.update(env.get('ENV', {}))
    return subprocess.run(
        command,
        check=False,
        env=process_environment,
    ).returncode

platform_matrix = test_env.Command(
    platform_matrix_stamp,
    [platform_matrix_script, platform_header],
    Action(_verify_platform_identity, 'Verifying desktop platform identity matrix'),
)
test_env.Depends(program, platform_matrix)

asset_layer_script = File('#Tests/verify_asset_layer.py')
architecture_script = File('#Tests/verify_architecture.py')
asset_layer_stamp = File('AssetLayerBoundary.stamp')

def _verify_asset_layer(target, source, env):
    command = [
        sys.executable,
        source[0].srcnode().abspath,
        '--root',
        Dir('#').abspath,
        '--stamp',
        target[0].abspath,
    ]
    return subprocess.run(command, check=False).returncode

asset_layer_boundary = test_env.Command(
    asset_layer_stamp,
    [asset_layer_script, architecture_script],
    Action(_verify_asset_layer, 'Verifying Asset -> Core architecture boundary'),
)
test_env.Depends(program, asset_layer_boundary)

asset_cooker_contract_script = File('#Tests/verify_asset_cooker_contracts.py')
asset_cooker_contract_stamp = File('AssetCookerContracts.stamp')
asset_cooker_contract_sources = [
    asset_cooker_contract_script,
    File('#.gitattributes'),
    File('#specs/025-asset-cooker-derived-data/contracts/target-profile.schema.json'),
    File('#specs/025-asset-cooker-derived-data/contracts/manifest.schema.json'),
    File('#specs/025-asset-cooker-derived-data/contracts/report.schema.json'),
    File('#Tests/Fixtures/AssetCooker/fixture-manifest.json'),
    File('#Config/AssetCooker/Profiles/Windows-Vulkan.json'),
    File('#Config/AssetCooker/Profiles/Mac-Vulkan.json'),
    File('#Config/AssetCooker/Profiles/Linux-Vulkan.json'),
    File('#Tests/Fixtures/AssetCooker/Contracts/Profiles/mac-vulkan.json'),
    File('#Tests/Fixtures/AssetCooker/Contracts/DerivedKeys/baseline.evidence.txt'),
    File('#Tests/Fixtures/AssetCooker/Contracts/DerivedKeys/baseline.expected.txt'),
    File('#Tests/Fixtures/AssetCooker/Contracts/Payloads/valid-image.sgasset'),
    File('#Tests/Fixtures/AssetCooker/Contracts/Payloads/invalid-truncated.sgasset'),
    File('#Tests/Fixtures/AssetCooker/Contracts/Payloads/invalid-body-digest.sgasset'),
    File('#Tests/Fixtures/AssetCooker/Contracts/Manifests/valid-manifest.json'),
    File('#Tests/Fixtures/AssetCooker/Contracts/Manifests/invalid-noncanonical.json'),
    File('#Tests/Fixtures/AssetCooker/Contracts/Manifests/invalid-generation.json'),
    File('#Tests/Fixtures/AssetCooker/Cli/valid-plan.args.json'),
    File('#Tests/Fixtures/AssetCooker/Cli/invalid-overlap.args.json'),
    File('#Tests/Fixtures/AssetCooker/Cli/exit-categories.json'),
    File('#Tests/Fixtures/AssetCooker/Reports/valid-plan.json'),
    File('#Tests/Fixtures/AssetCooker/Reports/invalid-profile.json'),
]

def _verify_asset_cooker_contracts(target, source, env):
    command = [
        sys.executable,
        source[0].srcnode().abspath,
        '--root',
        Dir('#').abspath,
    ]
    result = subprocess.run(command, check=False)
    if result.returncode == 0:
        with open(target[0].abspath, 'w', encoding='ascii') as output:
            output.write('passed\n')
    return result.returncode

asset_cooker_contracts = test_env.Command(
    asset_cooker_contract_stamp,
    asset_cooker_contract_sources,
    Action(
        _verify_asset_cooker_contracts,
        'Verifying Asset Cooker schemas and golden fixtures',
    ),
)
test_env.Depends(program, asset_cooker_contracts)

runtime_asset_manager_script = File('#Tests/verify_runtime_asset_manager.py')
runtime_asset_manager_stamp = File('RuntimeAssetManagerContracts.stamp')

def _verify_runtime_asset_manager(target, source, env):
    command = [
        sys.executable,
        source[0].srcnode().abspath,
        '--root',
        Dir('#').abspath,
        '--stamp',
        target[0].abspath,
