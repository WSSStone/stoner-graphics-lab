"""Core layer build script — shared utilities, no dependencies."""

Import('env', 'platform', 'config')
from LayerBuilder import BuildLayer

third_party_cflags = ['/w'] if platform == 'Win64' else ['-w']
lib = BuildLayer(
    env,
    'Core',
    [],
    private_c_sources=['ThirdParty/utf8proc/utf8proc.c'],
    third_party_cflags=third_party_cflags,
)
Return('lib')
