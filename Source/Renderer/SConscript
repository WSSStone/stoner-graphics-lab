"""Renderer layer build script — high-level rendering, depends on Asset, RHI, and Core.

After building the Renderer core library, auto-discovers sub-modules
(RayTracing/, Meshlets/, GI/, etc.) that contain their own SConscript files.
"""

Import('env', 'platform', 'config')
from LayerBuilder import BuildLayer, DiscoverSubModules
from ContentStaging import StageContent

lib = BuildLayer(env, 'Renderer', ['Asset', 'RHI', 'Core'])

shader_env = env.Clone()
shader_targets = StageContent(
    shader_env,
    [
        'Content/Shaders/Deferred/Composition.frag',
        'Content/Shaders/Deferred/Composition.frag.spv',
        'Content/Shaders/Deferred/Composition.shader.json',
        'Content/Shaders/Deferred/DirectionalLight.frag',
        'Content/Shaders/Deferred/DirectionalLight.frag.spv',
        'Content/Shaders/Deferred/DirectionalLight.shader.json',
        'Content/Shaders/Deferred/Fullscreen.vert',
        'Content/Shaders/Deferred/Fullscreen.vert.spv',
        'Content/Shaders/Deferred/PointLight.frag',
        'Content/Shaders/Deferred/PointLight.frag.spv',
        'Content/Shaders/Deferred/PointLight.shader.json',
        'Content/Shaders/Deferred/PointLight.vert',
        'Content/Shaders/Deferred/PointLight.vert.spv',
        'Content/Shaders/Deferred/SpotLight.frag',
        'Content/Shaders/Deferred/SpotLight.frag.spv',
        'Content/Shaders/Deferred/SpotLight.shader.json',
        'Content/Shaders/Deferred/SpotLight.vert',
        'Content/Shaders/Deferred/SpotLight.vert.spv',
        'Content/Shaders/Deferred/Surface.frag',
        'Content/Shaders/Deferred/Surface.frag.spv',
        'Content/Shaders/Deferred/Surface.shader.json',
        'Content/Shaders/Deferred/Surface.vert',
        'Content/Shaders/Deferred/Surface.vert.spv',
    ],
)

if shader_targets:
    Depends(lib, shader_targets)

# Auto-discover sub-modules (e.g., RayTracing, Meshlets, GI)
sub_libs = DiscoverSubModules(
    'Source/Renderer',
    exports={'env': env, 'platform': platform, 'config': config},
)

Return('lib')
