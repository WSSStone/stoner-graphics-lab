"""Backend aggregator — auto-discovers all backend sub-directories with SConscript files.

Uses DiscoverSubModules() to automatically find and delegate to each backend
implementation (Vulkan, DX12, DX11, Metal, OpenGL, GLES, WebGL, and any future
backends). No hardcoded backend list — new backends are picked up automatically
when a directory with a SConscript is added under Source/Backend/.

This SConscript runs in a variant_dir context (Build/<Platform>/<Config>/Backend/).
Sub-module SConscripts are called without their own variant_dir — they inherit
this aggregator's variant_dir context, so their StaticLibrary outputs land here.
"""

Import('env', 'platform', 'config')
from LayerBuilder import DiscoverSubModules

backend_libs = DiscoverSubModules(
    'Source/Backend',
    exports={'env': env, 'platform': platform, 'config': config},
)

Return('backend_libs')
