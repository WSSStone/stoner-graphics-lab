"""Application layer build script — game engine frontend, depends on Renderer and Core.

Layer isolation (FR-014): Application can only depend on Renderer and Core.
RHI is NOT exposed — Renderer's public headers do not leak RHI includes.
BuildLayer auto-discovers Private/*.cpp, including optional real-window adapter
stubs that remain hidden behind Application implementation boundaries.
"""

Import('env', 'platform', 'config')
from LayerBuilder import BuildLayer
from GraphicsDependencyDetect import DetectGraphicsDependencies

application_env = env.Clone()
deps = DetectGraphicsDependencies(platform)
application_env.Append(CPPDEFINES=[('STONER_GLFW_AVAILABLE', int(deps['glfw_available']))])
if deps['glfw_include_dir']:
    application_env.Append(CPPPATH=[deps['glfw_include_dir']])

lib = BuildLayer(application_env, 'Application', ['Renderer', 'Core'])
Return('lib')
