{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stoner.local/schemas/production-corpus-v1.json",
  "title": "Stoner Production Content Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "corpusRevision", "packages", "coverageClaims"],
  "properties": {
    "schema": {"const": "stoner.production-corpus"},
    "schemaVersion": {"const": 1},
    "corpusRevision": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"},
    "packages": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/package"}
    },
    "coverageClaims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/coverageClaim"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes", "role"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "sizeBytes": {"type": "integer", "minimum": 0},
        "role": {"enum": ["model", "buffer", "image", "other-source"]}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "workName", "packageName", "sourceLocation", "revision", "acquiredOn", "tier", "packageRoot", "sourcePath", "rootAssetId", "rootFile", "files", "coverageClaims"],
      "properties": {
        "packageId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "workName": {"type": "string", "minLength": 1, "maxLength": 128},
        "packageName": {"type": "string", "minLength": 1, "maxLength": 128},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 128},
        "sourceLocation": {"type": "string", "format": "uri", "pattern": "^https://"},
        "revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "acquiredOn": {"type": "string", "format": "date"},
        "tier": {"enum": ["regular", "medium"]},
        "packageRoot": {"$ref": "#/$defs/relativePath"},
        "sourcePath": {"$ref": "#/$defs/relativePath"},
        "rootAssetId": {"type": "string", "pattern": "^StaticModel:"},
        "rootFile": {"$ref": "#/$defs/relativePath"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
        "coverageClaims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "coverageClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "packageId", "subject", "evidence"],
      "properties": {
        "claimId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "packageId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "subject": {"type": "string", "minLength": 1, "maxLength": 512},
        "evidence": {"type": ["string", "number", "integer", "boolean", "object"]}
      }
    }
  }
}
