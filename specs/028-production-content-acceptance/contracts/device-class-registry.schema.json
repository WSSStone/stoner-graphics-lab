{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stoner.local/schemas/device-class-registry-v1.json",
  "title": "Stoner Production Device Class Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "registryVersion", "classes"],
  "properties": {
    "schema": {"const": "stoner.production-device-class-registry"},
    "schemaVersion": {"const": 1},
    "registryVersion": {"const": 1},
    "classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/deviceClass"}
    }
  },
  "$defs": {
    "deviceClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceClass", "capabilitySignature"],
      "properties": {
        "deviceClass": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,95}$"},
        "capabilitySignature": {"$ref": "#/$defs/capabilitySignature"}
      }
    },
    "capabilitySignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryVersion", "backendImplementation", "cpuArchitecture", "adapterFamily", "shaderProfile", "colorFormat", "depthFormat", "sampleCount", "textureFormatFamily"],
      "properties": {
        "registryVersion": {"const": 1},
        "backendImplementation": {"enum": ["native-vulkan", "moltenvk", "lavapipe", "native-metal"]},
        "cpuArchitecture": {"enum": ["x86_64", "arm64"]},
        "adapterFamily": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"},
        "shaderProfile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"},
        "colorFormat": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"},
        "depthFormat": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"},
        "sampleCount": {"type": "integer", "enum": [1, 2, 4, 8]},
        "textureFormatFamily": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"}
      }
    }
  }
}
