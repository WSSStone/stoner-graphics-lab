{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stoner.local/schemas/production-validation-profile-v3.json",
  "title": "Stoner Production Validation Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "profileId", "corpusRevision", "packageIds", "targetProfiles", "lifecycleCycles", "warmupCycles", "maxRssGrowthBytes", "timeBudgetSeconds", "profileTimeBudgetSeconds", "nativeTimeBudgetSeconds", "cadence", "requiredGates", "authorityPolicy"],
  "properties": {
    "schema": {"const": "stoner.production-validation-profile"},
    "schemaVersion": {"const": 3},
    "profileId": {"enum": ["regular", "medium", "hardware"]},
    "corpusRevision": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"},
    "packageIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "targetProfiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "maxLength": 256, "pattern": "^(?!/)(?!.*\\\\).+\\.json$"}
    },
    "lifecycleCycles": {"type": "integer"},
    "warmupCycles": {"type": "integer"},
    "maxRssGrowthBytes": {"const": 16777216},
    "timeBudgetSeconds": {"type": "integer"},
    "profileTimeBudgetSeconds": {"type": "integer"},
    "nativeTimeBudgetSeconds": {"type": "integer"},
    "cadence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["relevant-pull-request", "relevant-push", "weekly-default-branch", "feature-closeout", "release-closeout", "reference-image-change", "production-render-path-change"]
      }
    },
    "requiredGates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "authorityPolicy": {
      "oneOf": [
        {"$ref": "#/$defs/hostedLocalAuthorityPolicy"},
        {"$ref": "#/$defs/hardwareAuthorityPolicy"}
      ]
    }
  },
  "$defs": {
    "hostedLocalAuthorityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedExecutionClasses", "executionClasses", "physicalPreflight"],
      "properties": {
        "allowedExecutionClasses": {"const": ["github-hosted", "local-diagnostic"]},
        "executionClasses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["github-hosted", "local-diagnostic"],
          "properties": {
            "github-hosted": {"$ref": "#/$defs/observationalMeasurements"},
            "local-diagnostic": {"$ref": "#/$defs/observationalMeasurements"}
          }
        },
        "physicalPreflight": {"const": []}
      }
    },
    "hardwareAuthorityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedExecutionClasses", "executionClasses", "physicalPreflight"],
      "properties": {
        "allowedExecutionClasses": {"const": ["maintainer-local-metal", "maintainer-local-windows-vulkan", "local-diagnostic"]},
        "executionClasses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maintainer-local-metal", "maintainer-local-windows-vulkan", "local-diagnostic"],
          "properties": {
            "maintainer-local-metal": {"$ref": "#/$defs/metalPhysicalMeasurements"},
            "maintainer-local-windows-vulkan": {"$ref": "#/$defs/windowsVulkanPhysicalMeasurements"},
            "local-diagnostic": {"$ref": "#/$defs/observationalMeasurements"}
          }
        },
        "physicalPreflight": {
          "const": [
            "native-registered-target",
            "registered-device-class",
            "exclusive-local-device-session",
            "clean-frozen-revision-and-software",
            "default-production-allocator",
            "declared-sample-and-presentation-protocol"
          ]
        }
      }
    },
    "observationalMeasurements": {
      "const": {"rss": "observed", "timing": "operational", "image": "not-required"}
    },
    "metalPhysicalMeasurements": {
      "const": {"rss": "required", "timing": "operational", "image": "required"}
    },
    "windowsVulkanPhysicalMeasurements": {
      "const": {"rss": "observed", "timing": "operational", "image": "required"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"profileId": {"const": "regular"}}, "required": ["profileId"]},
      "then": {
        "properties": {
          "lifecycleCycles": {"const": 20},
          "warmupCycles": {"const": 2},
          "timeBudgetSeconds": {"const": 900},
          "profileTimeBudgetSeconds": {"const": 1200},
          "nativeTimeBudgetSeconds": {"const": 600}
          ,"authorityPolicy": {"$ref": "#/$defs/hostedLocalAuthorityPolicy"}
        }
      }
    },
    {
      "if": {"properties": {"profileId": {"const": "medium"}}, "required": ["profileId"]},
      "then": {
        "properties": {
          "lifecycleCycles": {"const": 1000},
          "warmupCycles": {"const": 20},
          "timeBudgetSeconds": {"const": 5400},
          "profileTimeBudgetSeconds": {"const": 5400},
          "nativeTimeBudgetSeconds": {"const": 4800},
          "authorityPolicy": {"$ref": "#/$defs/hostedLocalAuthorityPolicy"}
        }
      }
    },
    {
      "if": {"properties": {"profileId": {"const": "hardware"}}, "required": ["profileId"]},
      "then": {
        "properties": {
          "lifecycleCycles": {"const": 1000},
          "warmupCycles": {"const": 20},
          "timeBudgetSeconds": {"const": 3600},
          "profileTimeBudgetSeconds": {"const": 7800},
          "nativeTimeBudgetSeconds": {"const": 3600},
          "authorityPolicy": {"$ref": "#/$defs/hardwareAuthorityPolicy"}
        }
      }
    }
  ]
}
