{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stoner.local/schemas/hdr-live-view-attestation-v1.json",
  "title": "Stoner macOS HDR Live View Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schemaVersion", "attestationId", "requestId", "requestSha256",
    "gitRevision", "workloadRevision", "maintainerId", "reviewedAt",
    "deviceClass", "displayClass", "displayCapabilityDigest", "reviewSessionId",
    "observations", "acknowledgements", "supersedesAttestationId"
  ],
  "properties": {
    "schema": {"const": "stoner.hdr-live-view-attestation"},
    "schemaVersion": {"const": 1},
    "attestationId": {"$ref": "#/$defs/token"},
    "requestId": {"$ref": "#/$defs/token"},
    "requestSha256": {"$ref": "#/$defs/sha256"},
    "gitRevision": {"$ref": "#/$defs/gitRevision"},
    "workloadRevision": {"$ref": "#/$defs/token"},
    "maintainerId": {"$ref": "#/$defs/token"},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "deviceClass": {"$ref": "#/$defs/token"},
    "displayClass": {"$ref": "#/$defs/token"},
    "displayCapabilityDigest": {"$ref": "#/$defs/sha256"},
    "reviewSessionId": {"$ref": "#/$defs/token"},
    "observations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"profileId": {"const": "Hdr.PQ.Rec2020.1000.v1"}}}]},
        {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"profileId": {"const": "Hdr.PQ.Rec2020.2000.v1"}}}]},
        {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"profileId": {"const": "Hdr.Linear.1000.v1"}}}]},
        {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"profileId": {"const": "Hdr.Linear.2000.v1"}}}]}
      ],
      "items": false
    },
    "acknowledgements": {
      "const": [
        "live-metal-output-viewed",
        "no-sdr-capture-substitution",
        "no-automated-visual-decision"
      ]
    },
    "supersedesAttestationId": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/token"}]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "token": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "viewedLive", "decision", "observedDefects", "notes"],
      "properties": {
        "profileId": {"type": "string"},
        "viewedLive": {"const": true},
        "decision": {"enum": ["pass", "fail"]},
        "observedDefects": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "notes": {"type": "string", "maxLength": 1024}
      }
    }
  }
}
