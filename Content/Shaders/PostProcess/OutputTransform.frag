vec3 applyAces2HdrViewing(vec3 exposedLinearRec709)
{
    vec3 acesAp0 = multiplyRowVector(max(exposedLinearRec709, vec3(0.0)),
        Rec709D65ToAces2065_1D60);
    vec3 acesAp1 = multiplyRowVector(acesAp0, AcesAp0ToAcesAp1);
    float logarithmicPeak = log(Parameters.TargetPeakNits / 100.0) /
        log(10000.0 / 100.0);
    float upperBound = 8.0 * (128.0 + 768.0 * logarithmicPeak);
    acesAp1 = clamp(acesAp1, 0.0, upperBound);
    acesAp0 = multiplyRowVector(acesAp1, AcesAp1ToAcesAp0);

    vec4 rendered;
    if (Parameters.OutputProfile == 4u)
    {
        rendered = aces2_1000_rec2020_aces2(vec4(acesAp0, 1.0));
    }
    else if (Parameters.OutputProfile == 5u)
    {
        rendered = aces2_2000_rec2020_aces2(vec4(acesAp0, 1.0));
    }
    else if (Parameters.OutputProfile == 6u)
    {
        rendered = aces2_1000_rec709_aces2(vec4(acesAp0, 1.0));
    }
    else
    {
        rendered = aces2_2000_rec709_aces2(vec4(acesAp0, 1.0));
    }
    return clamp(rendered.rgb, 0.0, Parameters.TargetPeakNits / 100.0) * 100.0;
}

vec3 applyToneOrViewing(vec3 inputColor)
{
    if (Parameters.TransformStrategy == 1u)
    {
        return khronosPbrNeutral(inputColor);
    }
    if (Parameters.TransformStrategy == 2u)
    {
        return narkowiczAcesFit(inputColor);
    }
    if (Parameters.TransformStrategy == 3u)
    {
        return extendedReinhardRec709(inputColor);
    }
    return applyAces2HdrViewing(inputColor);
}

vec3 applyOutputDeviceTransform(vec3 displayLinearColor)
{
    if (Parameters.OutputProfile == 1u)
    {
        return linearToSrgb(clamp(displayLinearColor, 0.0, 1.0));
    }
    if (Parameters.OutputProfile == 2u)
    {
        return linearToBt709(clamp(displayLinearColor, 0.0, 1.0));
    }
    if (Parameters.OutputProfile == 3u)
    {
        return linearToGamma22(clamp(displayLinearColor, 0.0, 1.0));
    }
    if (Parameters.OutputProfile == 4u || Parameters.OutputProfile == 5u)
    {
        return linearNitsToPq(displayLinearColor);
    }
    return displayLinearColor / Parameters.ReferenceWhiteNits;
}

void main()
{
    vec3 inputColor = texture(InputColorTexture, UV).rgb;
    if (!isFiniteColor(inputColor))
    {
        OutColor = vec4(inputColor, 1.0);
        return;
    }

    vec3 outputColor;
    if (Parameters.StageMode == 0u)
    {
        outputColor = inputColor * Parameters.ExposureScale;
    }
    else if (Parameters.StageMode == 1u)
    {
        outputColor = applyToneOrViewing(inputColor);
    }
    else
    {
        outputColor = applyOutputDeviceTransform(inputColor);
    }
    OutColor = vec4(outputColor, 1.0);
}
