{
  "schema": "stoner.production-validation-profile",
  "schemaVersion": 3,
  "profileId": "hardware",
  "corpusRevision": "khronos-2026-08-19-v1",
  "packageIds": ["khronos-lantern-glb", "khronos-sponza-gltf"],
  "targetProfiles": [
    "Config/AssetCooker/Profiles/Production/Mac-Metal-Arm64.json",
    "Config/AssetCooker/Profiles/Production/Windows-Vulkan.json"
  ],
  "lifecycleCycles": 1000,
  "warmupCycles": 20,
  "maxRssGrowthBytes": 16777216,
  "timeBudgetSeconds": 3600,
  "profileTimeBudgetSeconds": 7800,
  "nativeTimeBudgetSeconds": 3600,
  "cadence": [
    "feature-closeout",
    "reference-image-change",
    "production-render-path-change"
  ],
  "requiredGates": [
    "strict-runtime",
    "transactional-realization",
    "deferred-native",
    "forward-native-smoke",
    "semantic-readback",
    "accepted-image-baseline",
    "window-only-capture",
    "lifecycle",
    "report"
  ],
  "authorityPolicy": {
    "allowedExecutionClasses": [
      "maintainer-local-metal",
      "maintainer-local-windows-vulkan",
      "local-diagnostic"
    ],
    "executionClasses": {
      "maintainer-local-metal": {
        "rss": "required",
        "timing": "operational",
        "image": "required"
      },
      "maintainer-local-windows-vulkan": {
        "rss": "observed",
        "timing": "operational",
        "image": "required"
      },
      "local-diagnostic": {
        "rss": "observed",
        "timing": "operational",
        "image": "not-required"
      }
    },
    "physicalPreflight": [
      "native-registered-target",
      "registered-device-class",
      "exclusive-local-device-session",
      "clean-frozen-revision-and-software",
      "default-production-allocator",
      "declared-sample-and-presentation-protocol"
    ]
  }
}
