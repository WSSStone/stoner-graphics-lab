      "github-hosted": {
        "rss": "observed",
        "timing": "operational",
        "image": "not-required"
      },
      "local-diagnostic": {
        "rss": "observed",
        "timing": "operational",
        "image": "not-required"
      }
    },
    "physicalPreflight": []
  }
}
