{
  "schema": "stoner.asset-target-profile",
  "schemaVersion": 1,
  "displayName": "Linux Vulkan Development",
  "platform": "linux",
  "cpuArchitecture": "x86_64",
  "graphicsBackend": "vulkan",
  "shaderPayloadChoices": [
    {
      "backend": "vulkan",
      "profile": "vulkan-1.3",
      "format": "spirv"
    }
  ],
  "textureCapabilities": ["etc2-rgba", "rgba8-unorm", "rgba16-float"],
  "textureFallback": "portable-ktx2",
  "buildPolicy": {
    "optimization": "development",
    "includeDebugSymbols": false,
    "validation": "strict",
    "producerSettings": [
      {
        "producer": "cooker.cooked-image-texture",
        "schemaVersion": 1,
        "settings": {
          "codecPolicy": "exact-v1"
        }
      },
      {
        "producer": "cooker.cooked-material-shader",
        "schemaVersion": 1,
        "settings": {
          "codecPolicy": "exact-v1"
        }
      },
      {
        "producer": "cooker.cooked-static-model",
        "schemaVersion": 1,
        "settings": {
          "codecPolicy": "exact-v1"
        }
      },
      {
        "producer": "cooker.ktx2",
        "schemaVersion": 1,
        "settings": {
          "allowLossyData": false,
          "compressionPolicy": "default-by-semantic",
          "portableProfile": "stoner.ktx2.portable.v1",
          "quality": "balanced"
        }
      }
    ]
  },
  "limits": {
    "maxDiscoveredSources": 100000,
    "maxAssets": 100000,
    "maxDependencyEdges": 1000000,
    "maxDependencyDepth": 256,
    "maxSourceBytes": 1073741824,
    "maxPayloadBytes": 1073741824,
    "maxAggregateBytes": 8589934592,
    "maxManifestBytes": 268435456,
    "maxDiagnostics": 4096
  }
}
